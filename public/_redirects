# Cloudflare Pages redirects.
# Legacy Jekyll hub URLs -> the new Astro site's routes, so published articles
# keep their SEO equity after the hub is retired.

/use-cases/*  /resources/:splat  301
/use-cases    /resources/        301
/tutorials/*  /resources/:splat  301
/tutorials    /resources/        301
/actors/*     /scrapers/:splat   301
/actors       /scrapers/         301
