---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import LogoMark from "../components/LogoMark.astro";
import { site, nav } from "../lib/site";
import { getActors, getPlatformGroups } from "../lib/actors";
import { PLATFORM_CONTENT, type HubPlatformId } from "../lib/platformContent";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.wordmark}` : `${site.wordmark} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

const actors = getActors();
const groups = getPlatformGroups();
const top = [...actors].sort((a, b) => b.stats.runs30 - a.stats.runs30).slice(0, 6);
const navLink = "text-muted transition-colors hover:text-text";
const isHub = (id: string): id is HubPlatformId => id in PLATFORM_CONTENT;
const hubHref = (id: string) =>
  isHub(id) ? `/${PLATFORM_CONTENT[id].slug}/` : `/scrapers/?platform=${id}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#07070c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.wordmark} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={new URL("/og/dataslayer-og.jpg", site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.wordmark} — scraper APIs for public social-media data`} />
    <meta name="twitter:image" content={new URL("/og/dataslayer-og.jpg", site.url).href} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-bg text-text">
    <header class="sticky top-0 z-40 border-b border-line bg-bg/70 backdrop-blur-xl">
      <div class="wrap flex h-16 items-center gap-4 lg:gap-8">
        <a href="/" class="flex shrink-0 items-center gap-2.5 text-[1.0625rem] font-semibold tracking-tight">
          <LogoMark size={30} />
          {site.wordmark}
        </a>
        <nav
          aria-label="Main"
          class="flex min-w-0 items-center gap-5 overflow-x-auto text-sm font-medium [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:gap-6"
        >
          {nav.map((item) => <a href={item.href} class={`${navLink} shrink-0`}>{item.label}</a>)}
        </nav>
        <a
          href={site.apifyProfileUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-sm btn-primary ml-auto hidden shrink-0 sm:inline-flex">Open on Apify</a
        >
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="mt-8 border-t border-line bg-panel">
      <div class="wrap grid gap-12 py-16 md:grid-cols-[minmax(0,5fr)_minmax(0,3fr)_minmax(0,5fr)_minmax(0,2fr)]">
        <div>
          <div class="flex items-center gap-2.5">
            <LogoMark size={26} />
            <p class="text-lg font-semibold tracking-tight">{site.wordmark}</p>
          </div>
          <p class="mt-3 max-w-[34ch] text-[0.9375rem] text-muted">
            {actors.length} scrapers for social media data, published on Apify Store as {site.publisher}.
          </p>
        </div>
        <div>
          <h2 class="label">platforms</h2>
          <ul class="mt-4 space-y-2.5 text-[0.9375rem] text-muted">
            {groups.map((g) => (
              <li><a href={hubHref(g.id)} class="transition-colors hover:text-text">{g.label} scrapers</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="label">most used</h2>
          <ul class="mt-4 space-y-2.5 text-[0.9375rem] text-muted">
            {top.map((a) => <li><a href={`/scrapers/${a.slug}/`} class="transition-colors hover:text-text">{a.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="label">site</h2>
          <ul class="mt-4 space-y-2.5 text-[0.9375rem] text-muted">
            <li><a href="/scrapers/" class="transition-colors hover:text-text">All scrapers</a></li>
            <li><a href="/docs" class="transition-colors hover:text-text">Docs</a></li>
            <li><a href="/pricing" class="transition-colors hover:text-text">Pricing</a></li>
            <li><a href="/playbooks" class="transition-colors hover:text-text">Playbooks</a></li>
            <li><a href="/blogs" class="transition-colors hover:text-text">Blog</a></li>
            <li><a href="/compare" class="transition-colors hover:text-text">Compare</a></li>
            <li><a href="/status" class="transition-colors hover:text-text">Status</a></li>
            <li><a href="/about" class="transition-colors hover:text-text">About</a></li>
            <li><a href="/contact" class="transition-colors hover:text-text">Contact</a></li>
            <li><a href="/llms.txt" class="transition-colors hover:text-text">llms.txt</a></li>
            <li>
              <a href={site.apifyProfileUrl} target="_blank" rel="noopener" class="transition-colors hover:text-text">Apify profile</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-line">
        <p class="wrap py-6 text-sm text-faint">
          {site.wordmark} publishes on Apify Store as {site.publisher} and is not affiliated with Instagram,
          LinkedIn, X, Facebook, TikTok or Reddit. Their names and logos are trademarks of their respective owners.
        </p>
      </div>
    </footer>

  </body>
</html>
