---
import Base from "../../layouts/Base.astro";
import ScraperCard from "../../components/ScraperCard.astro";
import RequestWindow from "../../components/RequestWindow.astro";
import StatStrip from "../../components/StatStrip.astro";
import PlatformLogo from "../../components/PlatformLogo.astro";
import JsonLd from "../../components/JsonLd.astro";
import { site, getPlatform } from "../../lib/site";
import { getActors, getActorBySlug, getRelated, getExampleInput } from "../../lib/actors";
import { buildCodeSamples, buildRowShape } from "../../lib/requests";
import { formatCount, formatNumber, formatUsd, formatPercent, formatDate, displayType } from "../../lib/format";
import { platformTint } from "../../lib/platform";
import { graph, softwareAppSchema, faqSchema, breadcrumbSchema } from "../../lib/seo";

export function getStaticPaths() {
  return getActors().map((actor) => ({ params: { slug: actor.slug } }));
}

const { slug } = Astro.params;
const actor = getActorBySlug(slug ?? "");
if (!actor) throw new Error(`Unknown scraper: ${slug}`);

const related = getRelated(actor, 3);
const example = getExampleInput(actor);
const samples = example ? buildCodeSamples(actor, example.value) : [];
const rowShape = buildRowShape(actor.output);
const price = actor.pricing?.per1kFrom ?? null;
const rate = actor.stats.runs30 > 0 ? actor.stats.succeeded30 / actor.stats.runs30 : null;
const lastRun = formatDate(actor.stats.lastRunStartedAt);
const outputs = actor.output.slice(0, 40);
const tint = platformTint(actor.platform);
const platformLabel = getPlatform(actor.platform).label;

const facts = [
  { value: formatCount(actor.stats.runs30), label: "runs · 30d" },
  { value: rate !== null ? formatPercent(rate) : "—", label: "success · 30d" },
  { value: formatCount(actor.stats.totalRuns), label: "runs all time" },
  { value: formatNumber(actor.stats.users30), label: "users · 30d" },
];

const faqs = [
  {
    q: `What does ${actor.name} return?`,
    a: `${actor.description} It returns ${actor.output.length} documented fields per record.`
  },
  {
    q: `How much does ${actor.name} cost?`,
    a:
      price !== null
        ? `It is priced at ${formatUsd(price)} per 1,000 results (lowest tier), billed through your Apify account. Failed runs are not billed as results.`
        : `Pricing is published on the scraper's Apify page, and runs are billed through your Apify account.`
  },
  {
    q: "What format does the data come back in?",
    a: "Typed JSON records by default. You can also download a run's dataset as CSV or Excel, or stream it into your own stack."
  },
  {
    q: "How reliable is this scraper?",
    a:
      rate !== null
        ? `Over the last 30 days it ran ${formatCount(actor.stats.runs30)} times with a ${formatPercent(rate)} success rate.`
        : `It has recorded ${formatCount(actor.stats.totalRuns)} runs all time.`
  },
  {
    q: "How do I run it?",
    a: "POST a JSON body to the actor's run endpoint with your Apify token, or open it on Apify and start a run from the console."
  },
];
---

<Base title={actor.seoTitle ?? actor.name} description={actor.seoDescription ?? actor.description}>
  <JsonLd
    data={graph([
      softwareAppSchema(actor),
      faqSchema(faqs),
      breadcrumbSchema([
        { name: "Home", path: "/" },
        { name: "Scrapers", path: "/scrapers/" },
        { name: actor.name, path: `/scrapers/${actor.slug}/` },
      ]),
    ])}
  />

  <section class="wrap pt-10">
    <nav class="text-sm text-faint" aria-label="Breadcrumb">
      <a class="hover:text-text" href="/scrapers/">Scrapers</a>
      <span class="px-2">/</span>
      <span class="text-muted">{actor.name}</span>
    </nav>

    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_20rem] lg:items-start">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 font-mono text-xs"
            style={`color:${tint};`}
          >
            <PlatformLogo platform={actor.platform} size={18} />
            {platformLabel}
          </span>
          {actor.tags.map((t) => <span class="label">{t}</span>)}
        </div>
        <h1 class="h-page mt-4">{actor.name}</h1>
        <p class="lead mt-4 max-w-2xl">{actor.description}</p>
        <div class="mt-8">
          <StatStrip stats={facts} />
        </div>
      </div>

      <aside class="panel p-5">
        <p class="label">Pricing</p>
        <p class="mt-2 font-mono text-2xl font-medium tracking-tight">
          {price !== null ? formatUsd(price) : "—"}
          <span class="text-sm font-normal text-muted"> / 1,000 results</span>
        </p>
        {actor.pricing?.startUsd != null && (
          <p class="mt-1 text-xs text-faint">Actor start {formatUsd(actor.pricing.startUsd)}</p>
        )}
        <a href={actor.apifyUrl} target="_blank" rel="noopener" class="btn btn-primary mt-5 w-full">Run on Apify ↗</a>
        {lastRun && <p class="mt-3 text-center text-xs text-faint">Last run {lastRun}</p>}
      </aside>
    </div>
  </section>

  {samples.length > 0 && (
    <section class="wrap py-12">
      <RequestWindow
        title={`POST /v2/acts/${site.apifyUsername}~${actor.apifyName}/run-sync-get-dataset-items`}
        samples={samples}
        rowShape={rowShape}
        fieldCount={actor.output.length}
      />
    </section>
  )}

  {outputs.length > 0 && (
    <section class="wrap py-12">
      <h2 class="h-section">Output fields</h2>
      <p class="mt-3 max-w-2xl text-[0.9375rem] text-muted">
        {actor.output.length} documented fields per record. Showing the first {outputs.length}.
      </p>
      <div class="panel mt-6 overflow-x-auto">
        <table class="data-table min-w-[48rem]">
          <thead>
            <tr>
              <th>Field</th>
              <th>Type</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            {outputs.map((f) => (
              <tr>
                <th scope="row" class="font-mono text-xs">{f.key}</th>
                <td class="text-muted">{displayType(f.type)}{f.nullable ? " · nullable" : ""}</td>
                <td class="text-muted">{f.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="wrap py-12">
      <h2 class="h-section">Related scrapers</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => <ScraperCard actor={r} />)}
      </ul>
    </section>
  )}

  <section class="wrap py-12">
    <h2 class="h-section">Frequently asked questions</h2>
    <div class="mt-6 border-y border-line">
      {faqs.map((f) => (
        <details class="group border-b border-line py-4 last:border-b-0">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-[0.9375rem] font-medium">
            {f.q}
            <span class="text-faint transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="px-3 pb-3 sm:px-4 sm:pb-4">
    <div class="surface-vivid grid-backdrop rounded-[1.75rem]">
      <div class="wrap py-16">
        <h2 class="h-page max-w-[20ch]">Run {actor.name} on Apify</h2>
        <p class="lead mt-4 max-w-[52ch]">
          One request, structured rows back. Pay per result through your Apify account.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={actor.apifyUrl} target="_blank" rel="noopener" class="btn btn-primary">Open on Apify ↗</a>
          <a href="/scrapers/" class="btn btn-secondary">Browse all scrapers</a>
        </div>
      </div>
    </div>
  </section>
</Base>
