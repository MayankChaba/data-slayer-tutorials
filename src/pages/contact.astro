---
import Base from "../layouts/Base.astro";
import { site } from "../lib/site";
---

<Base
  title="Contact"
  description={`How to reach ${site.wordmark} for support, questions about a scraper, or partnership.`}
>
  <section class="wrap pt-12 pb-10">
    <h1 class="h-page max-w-[24ch]">Get in touch</h1>
    <p class="lead mt-5 max-w-2xl">
      Questions about a scraper, a custom dataset, or a partnership? Reach us through our Apify
      profile — that is where runs, issues and support are handled.
    </p>
  </section>

  <section class="wrap grid gap-4 pb-16 md:grid-cols-3">
    <a
      href={site.apifyProfileUrl}
      target="_blank"
      rel="noopener"
      class="panel panel-hover flex flex-col gap-2 p-6"
    >
      <span class="label">Support</span>
      <h2 class="h-sub">Apify Store profile</h2>
      <p class="text-[0.9375rem] text-muted">
        Open an issue on any scraper, or message us from our Apify profile.
      </p>
      <span class="mt-auto pt-3 text-sm font-medium text-brand">Open on Apify →</span>
    </a>
    <a href="/docs" class="panel panel-hover flex flex-col gap-2 p-6">
      <span class="label">Documentation</span>
      <h2 class="h-sub">Read the docs</h2>
      <p class="text-[0.9375rem] text-muted">
        Authentication, the run endpoint, request bodies and typed responses.
      </p>
      <span class="mt-auto pt-3 text-sm font-medium text-brand">Go to docs →</span>
    </a>
    <a href="/scrapers/" class="panel panel-hover flex flex-col gap-2 p-6">
      <span class="label">Catalog</span>
      <h2 class="h-sub">Find a scraper</h2>
      <p class="text-[0.9375rem] text-muted">
        Browse all {site.wordmark} scrapers with live usage and price per result.
      </p>
      <span class="mt-auto pt-3 text-sm font-medium text-brand">Browse scrapers →</span>
    </a>
  </section>

  <section class="wrap pb-16">
    <div class="panel p-6 md:p-8">
      <h2 class="h-section">Need something custom?</h2>
      <p class="mt-3 max-w-2xl text-[0.9375rem] text-muted">
        If the dataset you need is not in the catalog, tell us what you are trying to collect. We
        publish new scrapers on Apify Store, so a custom request can become a public actor that
        anyone can run.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={site.apifyProfileUrl} target="_blank" rel="noopener" class="btn btn-primary">Message us on Apify</a>
        <a href="/playbooks" class="btn btn-secondary">Browse playbooks</a>
      </div>
    </div>
  </section>
</Base>
