---
import Base from "../../layouts/Base.astro";
import JsonLd from "../../components/JsonLd.astro";
import { site } from "../../lib/site";
import { getTotals } from "../../lib/actors";
import { formatUsd } from "../../lib/format";
import { COMPETITORS, type Competitor } from "../../lib/competitors";
import { graph, organizationSchema, websiteSchema, breadcrumbSchema, faqSchema } from "../../lib/seo";

export function getStaticPaths() {
  return COMPETITORS.map((c) => ({ params: { competitor: c.slug }, props: { competitor: c } }));
}

const { competitor } = Astro.props as { competitor: Competitor };
const totals = getTotals();
const fromPrice = totals.priceMin !== null ? formatUsd(totals.priceMin) : "—";
const path = `/compare/${competitor.slug}/`;
const title = `${competitor.name} alternative — ${site.wordmark}`;
---

<Base title={title} description={competitor.summary}>
  <JsonLd
    data={graph([
      organizationSchema(),
      websiteSchema(),
      breadcrumbSchema([
        { name: "Home", path: "/" },
        { name: "Compare", path: "/compare/" },
        { name: competitor.name, path },
      ]),
      faqSchema(competitor.faqs),
    ])}
  />

  <section class="wrap pt-12 pb-8">
    <nav class="text-sm text-faint" aria-label="Breadcrumb">
      <a class="transition-colors hover:text-text" href="/">Home</a>
      <span class="px-2">/</span>
      <a class="transition-colors hover:text-text" href="/compare/">Compare</a>
      <span class="px-2">/</span>
      <span class="text-muted">{competitor.name}</span>
    </nav>
    <h1 class="h-page mt-6 max-w-[24ch]">
      {site.wordmark} vs {competitor.name}
    </h1>
    <p class="lead mt-5 max-w-2xl">{competitor.summary}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/scrapers/" class="btn btn-primary">Browse {totals.count} scrapers</a>
      <a href="/pricing" class="btn btn-secondary">See pricing</a>
    </div>
  </section>

  <section class="wrap pb-12">
    <div class="panel overflow-x-auto">
      <table class="data-table min-w-[48rem]">
        <thead>
          <tr>
            <th class="w-[22%]"><span class="sr-only">Criterion</span></th>
            <th class="w-[39%] text-brand">{site.wordmark}</th>
            <th class="w-[39%]">{competitor.name}</th>
          </tr>
        </thead>
        <tbody>
          {competitor.rows.map(([criterion, ours, theirs]) => (
            <tr>
              <th scope="row">{criterion}</th>
              <td class="bg-brand/5">{ours}</td>
              <td class="text-muted">{theirs}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="label mt-3">
      {competitor.name} is a trademark of its respective owner and is not affiliated with {site.wordmark}.
      Provider details are summarised from public information and may change — check{" "}
      <a href={competitor.url} target="_blank" rel="noopener" class="text-link">{competitor.name}</a> for current
      features and pricing.
    </p>
  </section>

  <section class="wrap pb-12">
    <h2 class="h-section">Frequently asked questions</h2>
    <div class="mt-6 border-y border-line">
      {competitor.faqs.map((f) => (
        <details class="group border-b border-line py-4 last:border-b-0">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-[0.9375rem] font-medium">
            {f.q}
            <span class="text-faint transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="px-3 pb-3 sm:px-4 sm:pb-4">
    <div class="surface-vivid grid-backdrop rounded-[1.75rem]">
      <div class="wrap py-16">
        <h2 class="h-page max-w-[22ch]">Get structured social data without the parser</h2>
        <p class="lead mt-4 max-w-[52ch]">
          {totals.count} prebuilt scrapers, priced per result from {fromPrice} per 1,000.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/scrapers/" class="btn btn-primary">Browse scrapers</a>
          <a href={competitor.url} target="_blank" rel="noopener" class="btn btn-secondary">{competitor.name} ↗</a>
        </div>
      </div>
    </div>
  </section>
</Base>
