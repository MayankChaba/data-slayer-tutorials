---
/** The dataslayer mark: a terminal prompt glyph on a brand-blue tile. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
  class={`shrink-0 ${className}`}
>
  <defs>
    <linearGradient id="dsmark" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7c5cff"></stop>
      <stop offset="55%" stop-color="#a855f7"></stop>
      <stop offset="100%" stop-color="#d946ef"></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="15" fill="url(#dsmark)"></rect>
  <path
    d="M22 19.5 33 32 22 44.5"
    fill="none"
    stroke="#ffffff"
    stroke-width="6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path d="M36 44.5h9" fill="none" stroke="#ffffff" stroke-width="6" stroke-linecap="round"></path>
</svg>
