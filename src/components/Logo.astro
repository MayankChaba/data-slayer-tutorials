---
/** The dataslayer mark: a terminal prompt glyph. Inherits currentColor. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 26 26"
  fill="none"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect x="0.5" y="0.5" width="25" height="25" rx="7" fill="currentColor"></rect>
  <path
    d="M8 8.5 11.5 12.5 8 16.5"
    stroke="#fff"
    stroke-width="2.1"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path d="M13.5 16.5h5" stroke="#fff" stroke-width="2.1" stroke-linecap="round"></path>
</svg>
