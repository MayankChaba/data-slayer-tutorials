---
import PlatformLogo from "./PlatformLogo.astro";
import { formatCount, formatUsd } from "../lib/format";
import type { Actor } from "../lib/types";

interface Props {
  actors: Actor[];
  featured: string[];
}
const { actors, featured } = Astro.props;
const featuredSet = new Set(featured);

interface Row {
  slug: string;
  name: string;
  platform: Actor["platform"];
  runs30: number;
  price: number | null;
  haystack: string;
}
const rows: Row[] = actors.map((a) => ({
  slug: a.slug,
  name: a.name,
  platform: a.platform,
  runs30: a.stats.runs30,
  price: a.pricing?.per1kFrom ?? null,
  haystack: `${a.name} ${a.tags.join(" ")} ${a.description} ${a.platform}`.toLowerCase(),
}));
---

<div class="panel overflow-hidden shadow-2xl shadow-black/40" data-palette>
  <div class="flex items-center gap-2.5 border-b border-line bg-raised/40 px-4 py-3">
    <span aria-hidden="true" class="size-2 rounded-[2px] bg-brand"></span>
    <span class="label">scraper index</span>
    <span class="label ml-auto" data-count>{actors.length} scrapers</span>
  </div>
  <div class="relative border-b border-line">
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="pointer-events-none absolute left-4 top-1/2 size-4 -translate-y-1/2 text-faint"
      fill="none"
      stroke="currentColor"
      stroke-width="2.25"
      stroke-linecap="round"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.8-3.8"></path>
    </svg>
    <input
      data-input
      type="search"
      aria-label="Search scrapers"
      placeholder="Search: comments, followers, emails"
      class="h-14 w-full bg-transparent pl-11 pr-14 text-[0.9375rem] outline-offset-[-2px] placeholder:text-faint"
    />
    <kbd class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 rounded border border-line px-1.5 py-0.5 font-mono text-xs text-faint">/</kbd>
  </div>
  <ul data-list class="min-h-[22.75rem] p-2">
    {rows.map((row) => (
      <li
        data-row
        data-slug={row.slug}
        data-haystack={row.haystack}
        class={featuredSet.has(row.slug) ? "" : "hidden"}
      >
        <a
          href={`/scrapers/${row.slug}/`}
          class="flex items-center gap-3.5 rounded-lg px-3 py-2.5 outline-offset-[-2px]"
        >
          <PlatformLogo platform={row.platform} size={34} />
          <span class="min-w-0 flex-1">
            <span data-name data-raw={row.name} class="block truncate text-[0.9375rem] font-medium">{row.name}</span>
            <span class="label block">{formatCount(row.runs30)} runs / 30d</span>
          </span>
          <span class="whitespace-nowrap font-mono text-xs text-muted">
            <span class="text-text">{row.price !== null ? formatUsd(row.price) : "—"}</span> / 1K
          </span>
        </a>
      </li>
    ))}
  </ul>
  <div class="label flex items-center justify-between gap-4 border-t border-line px-4 py-3">
    <span class="max-sm:hidden">↑↓ move, ↵ open</span>
    <a href="/scrapers/" class="text-link">See all {actors.length} scrapers</a>
  </div>
</div>

<script is:inline>
  document.querySelectorAll("[data-palette]").forEach((root) => {
    const input = root.querySelector("[data-input]");
    const list = root.querySelector("[data-list]");
    const rows = Array.from(root.querySelectorAll("[data-row]"));
    const count = root.querySelector("[data-count]");
    const featured = rows.filter((r) => !r.classList.contains("hidden"));
    let active = 0;

    function escRe(s) {
      return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }
    function hl(text, tokens) {
      if (!tokens.length) return text;
      const p = new RegExp("(" + tokens.map(escRe).join("|") + ")", "ig");
      return text.replace(p, "<mark>$1</mark>");
    }
    function visible() {
      return rows.filter((r) => !r.classList.contains("hidden"));
    }
    function setActive(i) {
      const vis = visible();
      active = Math.max(0, Math.min(i, vis.length - 1));
      vis.forEach((r, idx) => {
        const a = r.querySelector("a");
        if (a) a.classList.toggle("bg-raised", idx === active);
      });
    }
    function render() {
      const tokens = (input.value || "").toLowerCase().split(/\s+/).filter(Boolean);
      const showFeatured = tokens.length === 0;
      const matches = rows.filter((r) => tokens.every((t) => r.getAttribute("data-haystack").includes(t)));
      const ordered = showFeatured
        ? featured
        : matches.slice().sort((a, b) => {
            const an = a.querySelector("[data-name]").getAttribute("data-raw").toLowerCase();
            const bn = b.querySelector("[data-name]").getAttribute("data-raw").toLowerCase();
            const ah = tokens.every((t) => an.includes(t)) ? 1 : 0;
            const bh = tokens.every((t) => bn.includes(t)) ? 1 : 0;
            return bh - ah;
          });
      const shown = ordered.slice(0, 6);
      rows.forEach((r) => r.classList.toggle("hidden", shown.indexOf(r) === -1));
      shown.forEach((r) => list.appendChild(r));
      rows.forEach((r) => {
        const span = r.querySelector("[data-name]");
        span.innerHTML = hl(span.getAttribute("data-raw"), showFeatured ? [] : tokens);
      });
      count.textContent = showFeatured ? rows.length + " scrapers" : matches.length + " of " + rows.length;
      setActive(0);
    }
    input.addEventListener("input", render);
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === "Enter") {
        const vis = visible();
        const a = vis[active] && vis[active].querySelector("a");
        if (a) window.location.href = a.getAttribute("href");
      }
    });
    window.addEventListener("keydown", (e) => {
      const el = document.activeElement;
      const typing = el && ["INPUT", "TEXTAREA", "SELECT"].indexOf(el.tagName) !== -1;
      if (e.key === "/" && !typing && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        input.focus();
      }
    });
    render();
  });
</script>
